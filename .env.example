# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct connection for migrations/type generation only (never used by the app)
SUPABASE_DB_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres

# GetStream
NEXT_PUBLIC_STREAM_KEY=
STREAM_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM=BabyBrain <onboarding@resend.dev>

# Internal
WEBHOOK_SHARED_SECRET=
# Set on Vercel for email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (Phase 2 vendor billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Connect events (account.*, payout.*) are only delivered to a separate
# endpoint created with connect:true, which has its own signing secret.
# Create it with: node scripts/setup-stripe-webhooks.mjs --apply
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional — only read when a vendor's terms say they absorb Stripe's fee.
# Defaults to 3.4% + 50c; lower it if your blended rate is better.
STRIPE_FEE_ESTIMATE_PERCENT=
STRIPE_FEE_ESTIMATE_FLAT_CENTS=
# Growth price ids + boost amount are stored in the app_config table (see docs/vendor-setup.md)

# Branded auth emails (Supabase → Authentication → Hooks → Send Email Hook).
# Generate a secret in the dashboard and paste it here; without it Supabase
# keeps sending its own unbranded templates.
AUTH_EMAIL_HOOK_SECRET=

# Contact form destination (defaults to hello@babybrain.sg).
SUPPORT_EMAIL=

# Klaviyo — private pk_ key. Without it profile/event sync is a no-op.
KLAVIYO_API_KEY=

# SMS provider for Claim Your Business phone codes. Until both are set the
# claim flow verifies by email only and says so in the UI.
SMS_API_KEY=
SMS_FROM=

# --- Vendor data pipeline (scripts/) ---
# Apify token for the website crawl (scripts/crawl-vendors.mjs).
APIFY_API_TOKEN=
# Structured extraction of the crawl (scripts/enrich-openai.mjs). Optional
# OPENAI_MODEL overrides the default; the model must support Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
# Legacy extractor (scripts/enrich-gemini.mjs).
GEMINI_API_KEY=

# Wix Bookings API (scripts/wix_bookings_test.py, lib/wix/*). Generate an API
# key on the Wix site dashboard and set the site ID; keep real values in
# .env.local only.
WIX_ACCESS_TOKEN=
WIX_SITE_ID=
